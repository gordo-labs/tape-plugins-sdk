{
  "name": "@gordo-labs/tape-plugins-sdk",
  "version": "0.3.0-beta.0",
  "description": "Manifest contract, permission and extension-point catalogs, and worker API types for Tape plugins.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gordo-labs/tape-plugins-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gordo-labs/tape-plugins-sdk/issues"
  },
  "homepage": "https://docs.tapemusicsuite.com/plugins",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-schemas.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
