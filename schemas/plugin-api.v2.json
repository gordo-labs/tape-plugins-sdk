  "hardLimits": {
    "workerMemoryBytes": 67108864,
    "workerStackBytes": 262144,
    "turnTimeoutMs": 1000,
    "handlerTimeoutMs": 30000,
    "maxConcurrentHostCalls": 8,
    "hostCallsPerMinute": 600,
    "maxPageSize": 200,
    "maxMessageBytes": 262144,
    "networkRequestsPerMinute": 60,
    "networkMaxResponseBytes": 2097152,
    "networkTimeoutMs": 15000,
    "storageQuotaBytes": 1048576,
    "storageMaxValueBytes": 65536,
    "notificationsPerMinute": 6,
    "logLinesPerMinute": 120,
    "failuresBeforeDisable": 3,
    "cpuBudgetMs": 15000,
    "cpuWindowMs": 60000,
    "rejectedReplyDelayMs": 250,
    "maxPendingRefusals": 1000,
    "maxConcurrentPageCalls": 4,
    "maxPlaylists": 1000,
    "maxPlaylistTrackIds": 5000,
    "badgeCommandBudgetMs": 1500,
    "fileReadMaxBytes": 1048576,
    "fileWriteMaxBytes": 8388608,
    "fileWriteCallsPerMinute": 60,
    "fileWriteBytesPerDay": 1073741824,
    "maxFileListEntries": 1000,
    "jobMinIntervalMinutes": 15,
    "jobMaxRunMs": 300000,
    "playbackCallsPerMinute": 30,
    "audioEffectChangesPerSecond": 10,
    "viewRendersPerMinute": 60,
    "viewMaxBytes": 262144,
    "viewMaxDepth": 12,
    "viewMaxNodes": 2000,
    "viewMaxTableRows": 500,
    "mobileCallsPerMinute": 300,
    "changesRetentionDays": 90,
    "changesMaxEntries": 5000,
    "waitMaxMs": 10000,
    "waitTotalMsPerMinute": 30000
  },
  "hostGuarantees": {
