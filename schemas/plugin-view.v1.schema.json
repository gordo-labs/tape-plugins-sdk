{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.tapemusicsuite.com/schemas/plugin-view.v1.schema.json",
  "title": "Tape declarative plugin view v1",
  "description": "A tree of Tape-drawn components. At most 262144 bytes serialized, 12 levels deep (the root is level 1) and 2000 nodes (list items and table rows count as one each). No string may be a URL; artwork is referenced by trackId or albumId.",
  "$ref": "#/$defs/node",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/stack"
        },
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/badge"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/form"
        },
        {
          "$ref": "#/$defs/empty"
        },
        {
          "$ref": "#/$defs/progress"
        }
      ]
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "type": {
          "const": "stack"
        },
        "direction": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "gap": {
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "children"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tone": {
          "enum": [
            "default",
            "muted",
            "success",
            "warning",
            "danger"
          ]
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "badge"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "tone": {
          "enum": [
            "default",
            "muted",
            "success",
            "warning",
            "danger"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "albumId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "trackId"
          ]
        },
        {
          "required": [
            "albumId"
          ]
        }
      ]
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "subtitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "image": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "trackId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "albumId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "trackId"
                    ]
                  },
                  {
                    "required": [
                      "albumId"
                    ]
                  }
                ]
              },
              "badges": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "actions": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "command"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "command": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$",
                      "maxLength": 64
                    },
                    "args": {
                      "type": "object",
                      "description": "JSON passed to the command as `args`. No URLs."
                    },
                    "tone": {
                      "enum": [
                        "default",
                        "primary",
                        "danger"
                      ]
                    },
                    "confirm": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 280
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ],
              "maxLength": 120
            }
          }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "command"
      ],
      "properties": {
        "type": {
          "const": "button"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "command": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 64
        },
        "args": {
          "type": "object",
          "description": "JSON passed to the command as `args`. No URLs."
        },
        "tone": {
          "enum": [
            "default",
            "primary",
            "danger"
          ]
        },
        "confirm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields",
        "submit"
      ],
      "properties": {
        "type": {
          "const": "form"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "select",
                  "toggle"
                ]
              },
              "default": {},
              "required": {
                "type": "boolean"
              },
              "placeholder": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  }
                }
              }
            }
          }
        },
        "submit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "command": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$",
              "maxLength": 64
            },
            "args": {
              "type": "object",
              "description": "JSON passed to the command as `args`. No URLs."
            }
          }
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "empty"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "progress"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
